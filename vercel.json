{
  "functions": {
    "api/analyze.js": { "maxDuration": 20 },
    "api/health.js": { "maxDuration": 5 },
    "api/evidence.js": { "maxDuration": 15 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type,X-Admin-Token" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/mobile-rendering-fix.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(app|ux-hotfix|availability-ui|test-lab).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, stale-while-revalidate=600" }
      ]
    }
  ]
}
