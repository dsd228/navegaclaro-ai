    {
      "parameters": {
        "jsCode": "const base = $json;\nconst when = new Date(base.appointmentAt).getTime();\nconst now = Date.now();\nconst reminders = [\n  {key:'24h',offset:24*60*60*1000},\n  {key:'2h',offset:2*60*60*1000}\n];\nreturn reminders.map(r=>({json:{...base,reminderKey:r.key,sendAt:new Date(when-r.offset).toISOString(),subject:`Recordatorio · turno ${r.key === '24h' ? 'mañana' : 'en 2 horas'}`,message:`Recordatorio: tenés ${base.service} el ${base.dateLabel}${base.professional ? ` con ${base.professional}` : ''}${base.location ? ` en ${base.location}` : ''}.`}})).filter(item=>new Date(item.json.sendAt).getTime()>now+60_000);"
      },
      "id": "build-reminders",
      "name": "Crear recordatorios 24h + 2h",
      "type": "n8n-nodes-base.code",
