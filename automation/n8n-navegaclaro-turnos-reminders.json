    {
      "parameters": {
        "jsCode": "const envelope = $json || {};\nconst headers = envelope.headers || {};\nconst body = envelope.body || envelope;\nconst provided = String(headers['x-navegaclaro-secret'] || headers['X-NavegaClaro-Secret'] || '');\nconst expected = String($env.NAVEGACLARO_SHARED_SECRET || '');\nif (!expected || provided !== expected) throw new Error('Unauthorized webhook');\nconst at = new Date(body.appointmentAt);\nif (!Number.isFinite(at.getTime()) || at.getTime() <= Date.now()) throw new Error('Invalid appointmentAt');\nconst channel = String(body.channel || '').toLowerCase();\nif (!['email','whatsapp'].includes(channel)) throw new Error('Invalid channel');\nconst appointmentId = String(body.appointmentId || `nc-${Date.now()}`);\nconst dateLabel = new Intl.DateTimeFormat('es-AR',{dateStyle:'full',timeStyle:'short',timeZone:'America/Argentina/Cordoba'}).format(at);\nconst destinationMasked = channel === 'email' ? String(body.email || '').replace(/^(.{2}).*(@.*)$/,'$1***$2') : String(body.whatsapp || '').replace(/.(?=.{4})/g,'*');\nreturn [{json:{appointmentId,appointmentAt:at.toISOString(),name:String(body.name||'').slice(0,80),email:String(body.email||'').slice(0,160),whatsapp:String(body.whatsapp||'').replace(/\\D/g,'').slice(0,15),channel,service:String(body.service||'Turno').slice(0,120),professional:String(body.professional||'').slice(0,120),location:String(body.location||'').slice(0,120),dateLabel,destinationMasked,createdAt:new Date().toISOString(),status:'confirmado',confirmationSubject:`Turno confirmado · ${String(body.service||'NavegaClaro')}`,confirmationText:`Tu turno quedó confirmado para ${dateLabel}${body.professional ? ` con ${body.professional}` : ''}${body.location ? ` en ${body.location}` : ''}. NavegaClaro te recordará antes del turno.`}}}];"
      },
